# Copy to .env and fill in values:
#   cp .env.example .env
#
# Variables load automatically from .env when you run npm run bootstrap | deploy | export

# --- Auth0 (required unless --skip-auth0) ---
AUTH0_DOMAIN=your-org.us.auth0.com
AUTH0_MGMT_CLIENT_ID=your_auth0_management_m2m_client_id
AUTH0_MGMT_CLIENT_SECRET=your_auth0_management_m2m_client_secret

# deploy = Auth0 Deploy CLI tenant.yaml (default)
# management = Auth0 Management API (legacy)
AUTH0_PROVISION_MODE=deploy

APP_NAME=Livepeer Platform
AUTH0_AUDIENCE=livepeer
# AUTH0_TENANT_YAML=./tenant.yaml

# --- Konnect Metering & Billing (required for npm run bootstrap; skipped by npm run deploy) ---
# Kong Konnect Metering & Billing API v3 (powered by OpenMeter).
# Docs: https://developer.konghq.com/api/konnect/metering-and-billing/v3/
#
# OPENMETER_URL = regional metering base (must end in /v3/openmeter for collector ingest).
# Pick the region that matches your Konnect org (US default below).
#   US: https://us.api.konghq.com/v3/openmeter
#   EU: https://eu.api.konghq.com/v3/openmeter
#   AU: https://au.api.konghq.com/v3/openmeter
#   SG: https://sg.api.konghq.com/v3/openmeter
#
# OPENMETER_API_KEY = Konnect Personal Access Token (kpat_…).
# Create at https://cloud.konghq.com/global/account/tokens/
# Needs Metering & Billing read/write scopes for bootstrap.
OPENMETER_URL=https://us.api.konghq.com/v3/openmeter
OPENMETER_API_KEY=kpat_your_konnect_personal_access_token
# OPENMETER_TRIAL_FEATURE_KEY=network_spend

# Legacy self-hosted / openmeter.cloud (optional — use om_… token instead of kpat_…):
# OPENMETER_URL=https://openmeter.cloud

# --- Optional: sdk-config.json placeholders (defaults work for local dev) ---
# SIGNER_PROXY_URL=http://127.0.0.1:3001/api/signer
# REMOTE_SIGNER_WEBHOOK_URL=http://127.0.0.1:8090/authorize

# --- Outputs ---
# BOOTSTRAP_OUTPUT=.env.livepeer
# SDK_CONFIG_OUTPUT=sdk-config.json

# --- Optional (export script: npm run export) ---
# EXPORT_OUTPUT_DIR=./export
