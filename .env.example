# Copy to .env and fill in values:
#   cp .env.example .env
#
# Variables load automatically from .env when you run npm run bootstrap | deploy | export

# --- Auth0 (required unless --skip-auth0) ---
AUTH0_DOMAIN=your-org.us.auth0.com
AUTH0_MGMT_CLIENT_ID=your_auth0_management_m2m_client_id
AUTH0_MGMT_CLIENT_SECRET=your_auth0_management_m2m_client_secret

# deploy = Auth0 Deploy CLI tenant.yaml (default)
# management = Auth0 Management API (legacy)
AUTH0_PROVISION_MODE=deploy

APP_NAME=Livepeer Platform
AUTH0_AUDIENCE=livepeer
# AUTH0_TENANT_YAML=./tenant.yaml

# --- OpenMeter (required for npm run bootstrap; skipped by npm run deploy) ---
# Default URL is https://openmeter.cloud — override for self-hosted.
# API key: OpenMeter Cloud → API → Create Token (Read and Write role)
# https://openmeter.io/docs/cloud/api/api-key
OPENMETER_URL=https://openmeter.cloud
OPENMETER_API_KEY=om_your_api_key
# OPENMETER_TRIAL_FEATURE_KEY=network_spend

# --- Optional: sdk-config.json placeholders (defaults work for local dev) ---
# SIGNER_PROXY_URL=http://127.0.0.1:3001/api/signer
# REMOTE_SIGNER_WEBHOOK_URL=http://127.0.0.1:8090/authorize

# --- Outputs ---
# BOOTSTRAP_OUTPUT=.env.livepeer
# SDK_CONFIG_OUTPUT=sdk-config.json

# --- Optional (export script: npm run export) ---
# EXPORT_OUTPUT_DIR=./export
