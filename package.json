{
  "name": "auth0-livepeer",
  "version": "0.2.0",
  "private": true,
  "description": "Bootstrap Auth0 + OpenMeter for Livepeer remote signer platform apps (scripts-only, not importable)",
  "type": "module",
  "exports": {},
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "deploy": "tsx scripts/deploy.ts",
    "export": "tsx scripts/export.ts",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:up:core": "bash scripts/stack-up.sh kafka remote-signer",
    "stack:down": "bash scripts/stack-down.sh",
    "stack:logs": "bash scripts/stack-logs.sh",
    "stack:smoke": "bash scripts/stack-smoke.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openmeter/sdk": "^1.0.0-beta.228",
    "auth0": "^4.21.0",
    "auth0-deploy-cli": "^8.11.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3"
  }
}
