# Required
auth0_domain             = "your-org.us.auth0.com"
auth0_mgmt_client_id     = "YOUR_TERRAFORM_M2M_CLIENT_ID"
auth0_mgmt_client_secret = "YOUR_TERRAFORM_M2M_CLIENT_SECRET"
app_name                 = "My Livepeer Platform"

# Optional — defaults shown
api_audience               = "livepeer"
token_lifetime_seconds     = 86400 # 24 hours
token_lifetime_web_seconds = 7200  # 2 hours
# webhook_secret           = ""    # leave empty to auto-generate
